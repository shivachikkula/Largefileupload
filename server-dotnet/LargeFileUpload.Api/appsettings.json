{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Azure": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ClientOrigin": "http://localhost:4200",
  "Storage": {
    // Either a connection string (account key / Azurite) ...
    "ConnectionString": "",
    // ... or an account URL used with DefaultAzureCredential (Managed Identity, `az login` locally).
    "AccountUrl": "",
    "UploadContainer": "uploads",
    "SessionContainer": "upload-sessions",
    // Lets the API set Blob service CORS rules at startup (handy for Azurite; use IaC in prod).
    "ConfigureCors": false
  },
  "Upload": {
    "MaxFileSize": 53687091200,
    "MinBlockSize": 8388608,
    "MaxBlocks": 50000,
    "SasTtlMinutes": 30,
    "SessionTtlDays": 7
  }
}
