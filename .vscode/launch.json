{
  // Start the storage emulator first: `npm run azurite` in server/ (or the Azurite VS Code extension).
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Node API",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/server",
      "program": "${workspaceFolder}/server/src/index.ts",
      // Runs the TypeScript directly (no build step) and loads server/.env
      "runtimeArgs": ["--env-file-if-exists=.env", "--import", "tsx"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    },
    {
      "name": "Debug .NET API",
      // Needs the C# Dev Kit (or C#) extension. Listens on http://localhost:3000 like the Node API.
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build .NET API",
      "program": "${workspaceFolder}/server-dotnet/LargeFileUpload.Api/bin/Debug/net10.0/LargeFileUpload.Api.dll",
      "cwd": "${workspaceFolder}/server-dotnet/LargeFileUpload.Api",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:3000"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Debug E2E resume test",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/server",
      "program": "${workspaceFolder}/server/scripts/e2e-resume.ts",
      "runtimeArgs": ["--env-file-if-exists=.env", "--import", "tsx"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    },
    {
      "name": "Attach to API (port 9229)",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    },
    {
      "name": "Debug Angular client (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:4200",
      "webRoot": "${workspaceFolder}/client"
    }
  ],
  "compounds": [
    {
      "name": "Debug Node API + Angular",
      "configurations": ["Debug Node API", "Debug Angular client (Chrome)"]
    },
    {
      "name": "Debug .NET API + Angular",
      "configurations": ["Debug .NET API", "Debug Angular client (Chrome)"]
    }
  ]
}
