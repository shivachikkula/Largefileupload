{
  "name": "largefileupload-server",
  "version": "1.0.0",
  "private": true,
  "description": "Resumable large-file upload API backed by Azure Blob Storage (block blobs)",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prestart": "npm run build",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "azurite": "azurite-blob --silent --skipApiVersionCheck --location .azurite --blobHost 127.0.0.1 --blobPort 10000",
    "test:e2e": "tsx --env-file-if-exists=.env scripts/e2e-resume.ts"
  },
  "dependencies": {
    "@azure/identity": "^4.13.3",
    "@azure/storage-blob": "^12.34.0",
    "cors": "^2.8.6",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "azurite": "^3.37.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  }
}
