# Local development against Azurite (npm run azurite)
AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true

# Production with Managed Identity instead of an account key:
# AZURE_STORAGE_ACCOUNT_URL=https://<account>.blob.core.windows.net

UPLOAD_CONTAINER=uploads
SESSION_CONTAINER=upload-sessions
PORT=3000
CLIENT_ORIGIN=http://localhost:4200
# Lets the server set Blob service CORS rules at startup (handy for Azurite; use IaC in prod)
CONFIGURE_STORAGE_CORS=true
